FROM oven/bun:1.3-alpine AS build
WORKDIR /app

# Install dependencies
COPY package.json bun.lock* ./
COPY client/package.json ./client/
COPY server/package.json ./server/
COPY packages/crypto/package.json ./packages/crypto/
RUN bun install --frozen-lockfile || bun install

# Copy source code
COPY client ./client
COPY packages/crypto ./packages/crypto
COPY server ./server

# Build client
WORKDIR /app/client
RUN bun run build

# Nginx static server
FROM docker.io/library/nginx:1.27-alpine AS production

# openssl is needed for generating htpasswd hashes
RUN apk add --no-cache openssl

COPY --from=build /app/client/dist /usr/share/nginx/html
COPY client/default.conf.template /etc/nginx/templates/default.conf.template
COPY client/docker-entrypoint.sh /docker-entrypoint-custom.sh

EXPOSE 80
ENTRYPOINT ["/docker-entrypoint-custom.sh"]
CMD ["nginx", "-g", "daemon off;"]
